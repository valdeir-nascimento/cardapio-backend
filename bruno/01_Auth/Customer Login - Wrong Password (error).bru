meta {
  name: Customer Login - Wrong Password (error)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{customerEmail}}",
    "password": "WrongPass!1"
  }
}

docs {
  Esperado: 401 com code `INVALID_CREDENTIALS`.
}
