meta {
  name: Customer Get Comanda
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/comandas/{{comandaId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  Retorna a comanda. Apenas membros conseguem ler — se o customer não
  fizer parte de `customerIds`, devolve 422 COMANDA_NOT_MEMBER.
}
