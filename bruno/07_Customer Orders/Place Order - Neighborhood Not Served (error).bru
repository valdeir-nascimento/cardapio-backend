meta {
  name: Place Order - Neighborhood Not Served (error)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/orders
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
  Idempotency-Key: not-served-{{$randomUUID}}
}

body:json {
  {
    "modality": "DELIVERY",
    "address": {
      "street": "Rua Inexistente",
      "number": "1",
      "complement": null,
      "district": "Inexistente",
      "city": "Salvador",
      "postalCode": "00000-000",
      "neighborhoodId": "00000000-0000-0000-0000-000000000000"
    }
  }
}

docs {
  Esperado: 422 com code `NEIGHBORHOOD_NOT_SERVED`.
}
