meta {
  name: Place Order - Idempotent Replay (same id)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/orders
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
  Idempotency-Key: replay-fixed-key-001
}

body:json {
  {
    "modality": "DELIVERY",
    "address": {
      "street": "Rua das Pitangas",
      "number": "200",
      "complement": null,
      "district": "Pituba",
      "city": "Salvador",
      "postalCode": "41820-100",
      "neighborhoodId": "{{neighborhoodId}}"
    }
  }
}

docs {
  Execute esta request DUAS VEZES com a mesma `Idempotency-Key` ⇒ retorna 201 com o MESMO `id` em ambas as chamadas (sem duplicar pedido no DB).
}
