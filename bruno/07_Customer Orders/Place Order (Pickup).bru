meta {
  name: Place Order (Pickup)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/orders
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
  Idempotency-Key: pickup-{{$randomUUID}}
}

body:json {
  {
    "modality": "PICKUP",
    "address": null
  }
}

docs {
  Modalidade PICKUP não exige endereço e tem `deliveryFee = 0`.
  Status inicial: RECEIVED → workflow termina em PICKED_UP.
}
