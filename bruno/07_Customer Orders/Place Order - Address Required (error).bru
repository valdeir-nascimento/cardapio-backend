meta {
  name: Place Order - Address Required (error)
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/orders
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
  Idempotency-Key: no-address-{{$randomUUID}}
}

body:json {
  {
    "modality": "DELIVERY",
    "address": null
  }
}

docs {
  Esperado: 422 — `ADDRESS_REQUIRED` para modalidade DELIVERY sem endereço.
}
