meta {
  name: Place Order - Empty Cart (error)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/orders
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
  Idempotency-Key: empty-{{$randomUUID}}
}

body:json {
  {
    "modality": "PICKUP",
    "address": null
  }
}

docs {
  Esperado: 422 com code `CART_EMPTY` quando o carrinho não tem itens.
}
