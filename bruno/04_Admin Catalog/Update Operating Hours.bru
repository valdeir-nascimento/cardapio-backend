meta {
  name: Update Operating Hours
  type: http
  seq: 15
}

put {
  url: {{baseUrl}}/api/v1/admin/operating-hours
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "hoursByDay": {
      "MONDAY":    [{"openTime":"11:00","closeTime":"15:00"},{"openTime":"18:00","closeTime":"23:00"}],
      "TUESDAY":   [{"openTime":"11:00","closeTime":"15:00"},{"openTime":"18:00","closeTime":"23:00"}],
      "WEDNESDAY": [{"openTime":"11:00","closeTime":"15:00"},{"openTime":"18:00","closeTime":"23:00"}],
      "THURSDAY":  [{"openTime":"11:00","closeTime":"15:00"},{"openTime":"18:00","closeTime":"23:00"}],
      "FRIDAY":    [{"openTime":"11:00","closeTime":"15:00"},{"openTime":"18:00","closeTime":"23:30"}],
      "SATURDAY":  [{"openTime":"11:00","closeTime":"23:30"}],
      "SUNDAY":    [{"openTime":"17:00","closeTime":"22:00"}]
    }
  }
}
