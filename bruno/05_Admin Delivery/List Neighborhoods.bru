meta {
  name: List Neighborhoods (admin - all)
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/admin/neighborhoods
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

script:post-response {
  if (res.status === 200 && Array.isArray(res.body) && res.body.length > 0) {
    bru.setEnvVar("neighborhoodId", res.body[0].id);
  }
}

docs {
  Lista TODOS os bairros (ativos e inativos). Use o endpoint público para apenas os ativos.
}
