meta {
  name: Update Neighborhood
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/api/v1/admin/neighborhoods/{{neighborhoodId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Pituba",
    "city": "Salvador",
    "fee": 9.50,
    "active": true
  }
}
