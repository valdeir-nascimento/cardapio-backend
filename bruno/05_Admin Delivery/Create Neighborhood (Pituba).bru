meta {
  name: Create Neighborhood (Pituba)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/admin/neighborhoods
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Pituba",
    "city": "Salvador",
    "fee": 8.50,
    "active": true
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("neighborhoodId", res.body.id);
  }
}
