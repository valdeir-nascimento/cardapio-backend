meta {
  name: Get Menu
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/menu
  auth: none
}

script:post-response {
  if (res.status === 200) {
    const cats = res.body.categories || [];
    for (const c of cats) {
      if (c.id) bru.setEnvVar("categoryId", c.id);
      const prods = c.products || [];
      if (prods.length > 0 && prods[0].id) {
        bru.setEnvVar("productId", prods[0].id);
        break;
      }
    }
  }
}

docs {
  Anônimo. Salva `categoryId` e `productId` da primeira categoria/produto encontrado.
}
