meta {
  name: Admin Create Table
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/admin/tables
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminAccessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "number": 7
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("tableId", res.body.id);
    bru.setEnvVar("qrToken", res.body.qrToken);
  }
}

docs {
  Cria mesa nova. Gera qrToken UUID + uploads PNG no storage.
  O qrToken vai para a env var para os requests de "resolve".
}
